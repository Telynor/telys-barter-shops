<div class="tbs-app-root">
<div class="tbs-window-actions"><button type="button" data-action="windowMinimize" title="Minimize"><i class="fa-solid fa-minus"></i></button><button type="button" data-action="windowClose" title="Close"><i class="fa-solid fa-xmark"></i></button></div>
<div class="tbs-shell">
  {{#unless shop}}
    <header class="tbs-hero"><div><span class="tbs-kicker">MARKETPLACE</span><h1>Available Shops</h1><p>Choose a merchant to browse their inventory.</p></div></header>
    <div class="tbs-shop-grid">
      {{#each shops}}<button type="button" class="tbs-shop-card {{#if closed}}is-closed{{/if}}" data-action="choose" data-shop-id="{{id}}"><img src="{{cardImage}}" alt="{{name}}"><span><strong>{{name}}</strong><small>{{#if closed}}Closed{{else}}Open now{{/if}}</small></span><i class="fa-solid fa-chevron-right"></i></button>
      {{else}}<div class="tbs-empty"><i class="fa-solid fa-store-slash"></i><h2>No shops available</h2><p>A Game Master can grant you access from the shop manager.</p></div>{{/each}}
    </div>
  {{else}}
    {{#if sellMode}}
      <section class="tbs-sell-screen">
        <header class="tbs-shop-header"><button type="button" data-action="backToShop" aria-label="Back to shop"><i class="fa-solid fa-arrow-left"></i></button><img class="tbs-vendor-image" src="{{shop.vendorImage}}" alt="Vendor"><div class="tbs-shop-copy"><span class="tbs-kicker">SALE NEGOTIATION</span><h1>Sell to {{shop.name}}</h1><p>{{#if actor}}{{actor.name}} is making this offer.{{else}}Select a token or assign a character first.{{/if}}</p></div></header>
        {{#if tradeCounter}}
          <div class="tbs-trade-status tbs-counter-status"><i class="fa-solid fa-comments-dollar"></i><div><strong>{{shop.name}} sent a counteroffer</strong><p>You give {{trade.sellerSummary}} and receive {{trade.requestSummary}}.</p></div></div>
          <div class="tbs-trade-actions"><button class="primary" type="button" data-action="acceptCounter"><i class="fa-solid fa-check"></i> Accept Counteroffer</button><button type="button" data-action="reviseCounter"><i class="fa-solid fa-pen"></i> Make Another Counteroffer</button><button class="danger" type="button" data-action="abandonTrade"><i class="fa-solid fa-ban"></i> Abort Trade</button></div>
        {{else if tradePlayerRevision}}
          <div class="tbs-trade-status tbs-counter-status"><i class="fa-solid fa-pen-to-square"></i><div><strong>Build your counteroffer</strong><p>The GM proposed: you give {{trade.sellerSummary}} and receive {{trade.requestSummary}}. Adjust those terms below.</p></div></div>
          <h2 class="tbs-section-title">1. Items your character will give</h2>
          <div class="tbs-counter-items">{{#each actorChoices}}<label><span><img src="{{img}}">{{name}} <small>{{quantity}} owned · {{containerName}}</small></span><input type="number" data-player-seller-item="{{id}}" data-name="{{name}}" min="0" max="{{quantity}}" value="{{selected}}"></label>{{else}}<p class="tbs-muted">No transferable items are available.</p>{{/each}}</div>
          <h2 class="tbs-section-title">2. What you want from the shop</h2>
          <div class="tbs-ask-grid"><label class="tbs-ask-currency"><span><i class="fa-solid fa-coins"></i> Gold requested</span><input type="number" data-player-counter-gold min="0" value="{{askedGold}}"></label>
            {{#each shopOfferItems}}<label class="tbs-ask-currency"><span><img src="{{img}}" alt="">{{name}}</span><small>{{available}} in public stock</small><input type="number" data-player-shop-item="{{id}}" min="0" max="{{max}}" value="{{asked}}"></label>{{/each}}
          </div>
          <div class="tbs-trade-actions"><button class="primary" type="button" data-action="submitPlayerCounter"><i class="fa-solid fa-paper-plane"></i> Send Counteroffer</button><button class="danger" type="button" data-action="abandonTrade"><i class="fa-solid fa-ban"></i> Abort Trade</button></div>
        {{else if tradePending}}
          <div class="tbs-trade-status"><i class="fa-solid fa-hourglass-half"></i><div><strong>Waiting for the GM</strong><p>{{trade.quantity}} × {{trade.itemName}} for {{#if trade.requestSummary}}{{trade.requestSummary}}{{else}}your requested payment{{/if}}.</p></div></div>
          <div class="tbs-trade-actions"><button class="danger" type="button" data-action="abandonTrade"><i class="fa-solid fa-ban"></i> Abandon Trade</button></div>
        {{else}}
          {{#if tradeRevision}}<div class="tbs-revision-banner"><i class="fa-solid fa-rotate-left"></i> The GM said no. Nothing was moved. Adjust the offer below and submit it again.</div>{{/if}}
          <h2 class="tbs-section-title">1. What are you selling?</h2>
          <div class="tbs-sell-drop">
            {{#if sellItem}}<div class="tbs-sell-item"><img src="{{sellItem.img}}" alt="{{sellItem.name}}"><div><strong>{{sellItem.name}}</strong><small>You own {{sellItem.max}}</small></div><label>Quantity<input type="number" data-sell-quantity min="1" max="{{sellItem.max}}" value="{{sellItem.quantity}}"></label><button class="danger" type="button" data-action="clearSellItem" title="Remove item"><i class="fa-solid fa-xmark"></i></button></div>
            {{else}}<div class="tbs-drop"><i class="fa-solid fa-hand-holding-box"></i><strong>Drag an item from {{actor.name}}'s inventory here</strong><small>No item leaves the character until the GM accepts.</small></div>{{/if}}
          </div>
          <h2 class="tbs-section-title">2. What do you want in return?</h2>
          <div class="tbs-ask-grid"><label class="tbs-ask-currency"><span><i class="fa-solid fa-coins"></i> Gold</span><input type="number" data-ask-gold min="0" value="{{askedGold}}"></label>
            {{#each shopOfferItems}}<label class="tbs-ask-currency"><span><img src="{{img}}" alt="">{{name}}</span><small>{{available}} in public stock</small><input type="number" data-ask-listing-id="{{id}}" min="0" max="{{max}}" value="{{asked}}"></label>{{else}}<p class="tbs-muted">This merchant has no public shop items available.</p>{{/each}}
          </div>
          <div class="tbs-trade-actions"><button class="primary" type="button" data-action="submitTrade" {{#unless actor}}disabled{{/unless}}><i class="fa-solid fa-paper-plane"></i> Submit Offer</button><button class="danger" type="button" data-action="abandonTrade"><i class="fa-solid fa-ban"></i> Abandon Trade</button></div>
        {{/if}}
      </section>
    {{else}}
      <div class="tbs-shop-banner" style="background-image:url('{{shop.image}}')"></div>
      <header class="tbs-shop-header"><button type="button" data-action="back" aria-label="Back"><i class="fa-solid fa-arrow-left"></i></button><img class="tbs-vendor-image" src="{{shop.vendorImage}}" alt="Vendor"><div class="tbs-shop-copy"><span class="tbs-kicker">{{#if shop.open}}OPEN{{else}}CLOSED{{/if}}</span><h1>{{shop.name}}</h1><p>{{shop.description}}</p></div>{{#if actor}}<div class="tbs-wallet"><small>Shopping as</small><strong>{{actor.name}}</strong></div>{{/if}}</header>
      {{#unless shop.open}}<div class="tbs-closed-banner"><i class="fa-solid fa-lock"></i> This shop is currently closed.</div>{{/unless}}
      <h2 class="tbs-section-title">Shop Inventory</h2>
      <div class="tbs-product-grid" style="--tile-size: {{tileSize}}px">
      {{#each listings}}<article class="tbs-product {{#if soldOut}}is-sold{{/if}}"><div class="tbs-product-image"><img src="{{item.img}}" alt="{{item.name}}"></div><div class="tbs-product-body"><h3 title="{{item.name}}">{{item.name}}</h3><div class="tbs-meta"><span>{{#if isBestOffer}}Best Offer{{else}}{{costText}}{{/if}}</span><span>{{#if stock}}{{stock}} in stock{{else}}{{#if soldOut}}Sold out{{else}}Unlimited stock{{/if}}{{/if}}</span></div>
        <div class="tbs-buy-controls"><label class="tbs-buy-field">Quantity wanted<select data-quantity-select>{{#each quantityOptions}}<option value="{{this}}">{{this}}</option>{{/each}}</select></label><label class="tbs-buy-field">Bulk shortcut<input type="number" data-bulk-quantity min="1" {{#if stock}}max="{{stock}}"{{/if}} placeholder="Type amount"></label></div>
        {{#if isBestOffer}}<div class="tbs-offer-drop" data-offer-listing-id="{{id}}"><strong>Drag loot items here</strong>{{#each draftItems}}<div class="tbs-offer-item"><img src="{{img}}"><span>{{name}}</span><input type="number" min="1" max="{{max}}" value="{{quantity}}" data-offer-item-id="{{itemId}}"><button type="button" data-action="removeOfferItem" data-listing-id="{{../id}}" data-item-id="{{itemId}}"><i class="fa-solid fa-xmark"></i></button></div>{{/each}}</div><label class="tbs-buy-field">Gold offered<input type="number" min="0" value="0" data-offer-gold></label><button type="button" data-action="submitOffer" data-listing-id="{{id}}" {{#if ../shop.open}}{{else}}disabled{{/if}} {{#if soldOut}}disabled{{/if}}><i class="fa-solid fa-handshake"></i> Submit Best Offer</button>
        {{else}}{{#if showPaymentChoice}}<label class="tbs-buy-field">Pay with<select data-payment-select><option value="barter">{{cost.quantity}} × {{cost.name}}</option><option value="currency">{{cost.amount}} {{cost.denomination}}</option></select></label>{{/if}}<button type="button" data-action="buy" data-listing-id="{{id}}" {{#if ../shop.open}}{{else}}disabled{{/if}} {{#if soldOut}}disabled{{/if}}><i class="fa-solid fa-bag-shopping"></i> Buy {{bundle}} each</button>{{/if}}
      </div></article>
      {{else}}<div class="tbs-empty"><p>This merchant has no items for sale.</p></div>{{/each}}
      </div>
      {{#if canSell}}<div class="tbs-open-sell"><button class="primary" type="button" data-action="openSell" {{#unless shop.open}}disabled{{/unless}}><i class="fa-solid fa-handshake"></i> Sell or Propose a Trade</button><small>Drag one inventory item into a private offer and ask the merchant for gold or custom currency.</small></div>{{/if}}
    {{/if}}
  {{/unless}}
</div>
</div>
