<div class="tbs-app-root">
<div class="tbs-window-actions"><button type="button" data-action="windowMinimize" title="Minimize"><i class="fa-solid fa-minus"></i></button><button type="button" data-action="windowClose" title="Close"><i class="fa-solid fa-xmark"></i></button></div>
<div class="tbs-manager-layout">
  <aside>
    <div class="tbs-aside-title"><strong>Shops</strong><button type="button" data-action="create"><i class="fa-solid fa-plus"></i></button></div>
    {{#each shops}}<button type="button" class="tbs-manager-shop" data-action="select" data-shop-id="{{id}}"><i class="fa-solid fa-store"></i><span>{{name}}</span>{{#if open}}<b>OPEN</b>{{else}}<b class="closed">CLOSED</b>{{/if}}</button>{{/each}}
  </aside>
  <main>
    {{#if shop}}<form>
      <div class="tbs-manager-head"><div><span class="tbs-kicker">SHOP EDITOR</span><h1>{{shop.name}}</h1></div><div><button class="danger" type="button" data-action="remove"><i class="fa-solid fa-trash"></i></button><button class="primary" type="button" data-action="save"><i class="fa-solid fa-floppy-disk"></i> Save Shop</button></div></div>
      <section class="tbs-panel"><h2>Shopfront</h2><div class="tbs-fields">
        <label>Name<input name="name" value="{{shop.name}}"></label><label>Shop/banner image<input name="image" value="{{shop.image}}" placeholder="path/to/shop.webp"></label><label>Vendor portrait<input name="vendorImage" value="{{shop.vendorImage}}" placeholder="path/to/vendor.webp"></label><label class="wide">Description<textarea name="description">{{shop.description}}</textarea></label>
        <label class="switch">Open for business<input type="checkbox" name="open" {{checked shop.open}}></label><label>Player access<select name="access"><option value="all" {{#if (eq shop.access 'all')}}selected{{/if}}>All players</option><option value="selected" {{#if (eq shop.access 'selected')}}selected{{/if}}>Selected players</option></select></label>
        <label>Price markup<input type="number" name="markup" min="0" step="0.05" value="{{shop.markup}}"></label><label>Tile width<input type="range" name="tileSize" min="160" max="360" value="{{shop.tileSize}}"></label>
      </div><div class="tbs-user-chips">{{#each users}}<label><input type="checkbox" name="users" value="{{id}}" {{checked checked}}><span>{{name}}</span></label>{{/each}}</div></section>
      <section class="tbs-panel"><div class="tbs-panel-title"><h2>Merchant gold & barter currency</h2><small>Drag custom loot currency items into the box.</small></div><div class="tbs-fields"><label>Gold reserve (GP)<input type="number" min="0" name="merchantGp" value="{{shop.till.currency.gp}}"></label></div><div class="tbs-currency-drop">
        {{#each shop.till.items}}<div class="tbs-currency-row"><img src="{{img}}"><strong>{{name}}</strong><label>Merchant quantity<input type="number" min="0" name="currency.{{id}}.quantity" value="{{quantity}}"></label><button class="danger icon" type="button" data-action="removeCurrency" data-currency-id="{{id}}"><i class="fa-solid fa-xmark"></i></button></div>
        {{else}}<div class="tbs-drop"><i class="fa-solid fa-coins"></i><strong>Drop a custom currency loot item here</strong></div>{{/each}}
      </div></section>
      <section class="tbs-panel"><h2>Buyback</h2><div class="tbs-fields"><label class="switch">Buy items from players<input type="checkbox" name="buybackEnabled" {{checked shop.buyback.enabled}}></label><label>Payout rate<input type="number" name="buybackRate" min="0" step="0.05" value="{{shop.buyback.rate}}"></label><label>Pay denomination<input name="buybackDenomination" value="{{shop.buyback.denomination}}"></label></div></section>
      <section class="tbs-panel"><div class="tbs-panel-title"><h2>Best Offers</h2><small>Items and gold remain with the player until you accept.</small></div><div class="tbs-offer-queue">{{#each offers}}<article><img src="{{listingImg}}"><div><strong>{{actorName}} offers for {{requestedQuantity}} × {{listingName}}</strong><small>{{summary}}</small></div><button class="primary" type="button" data-action="acceptOffer" data-offer-id="{{id}}"><i class="fa-solid fa-check"></i> Accept</button><button class="danger" type="button" data-action="denyOffer" data-offer-id="{{id}}"><i class="fa-solid fa-xmark"></i> Deny</button></article>{{else}}<div class="tbs-drop"><i class="fa-solid fa-handshake"></i><strong>No pending offers</strong></div>{{/each}}</div></section>
      <section class="tbs-panel"><div class="tbs-panel-title"><h2>Player Sale Negotiations</h2><small>New proposals open this manager automatically. No inventory changes until final acceptance.</small></div><div class="tbs-trade-queue">{{#each trades}}<article data-trade-card data-trade-id="{{id}}"><div class="tbs-trade-head"><img src="{{itemImg}}" alt="{{itemName}}"><div><strong>{{actorName}} offers {{sellerSummary}} to {{../shop.name}} for {{requestSummary}}. Do you accept?</strong>{{#if counter}}<small>Counteroffer sent—waiting for {{actorName}}.</small>{{else if pending}}<small>Accept it, decline it, or select only from {{actorName}}'s inventory to build a counteroffer.</small>{{else}}<small>Returned to the player for changes.</small>{{/if}}</div></div>
        {{#if pending}}<div class="tbs-counter-editor"><h3>Merchant counteroffer</h3><h4>Items {{actorName}} must give</h4><div class="tbs-counter-items">{{#each sellerChoices}}<label><span><img src="{{img}}">{{name}} <small>{{quantity}} owned · {{containerName}}</small></span><input type="number" data-counter-seller-item="{{id}}" data-name="{{name}}" min="0" max="{{quantity}}" value="{{selected}}"></label>{{else}}<small>No transferable items are available on the offering character.</small>{{/each}}</div><label>Merchant gold ({{../shop.till.currency.gp}} GP available)<input type="number" data-counter-gold min="0" max="{{../shop.till.currency.gp}}" value="{{gold}}"></label><h4>Public shop inventory</h4><div class="tbs-counter-items">{{#each listingChoices}}<label><span><img src="{{img}}">{{name}} <small>{{quantity}} in stock</small></span><input type="number" data-counter-listing="{{id}}" data-name="{{name}}" min="0" max="{{max}}" value="{{selected}}"></label>{{else}}<small>No public shop items.</small>{{/each}}</div><h4>Merchant payment from private reserves</h4><div class="tbs-counter-items">{{#each reserveChoices}}<label><span><img src="{{img}}">{{name}} <small>{{quantity}} available</small></span><input type="number" data-counter-reserve="{{id}}" data-name="{{name}}" min="0" max="{{quantity}}" value="{{selected}}"></label>{{else}}<small>No shop currency items.</small>{{/each}}</div></div>
        {{#if cannotAccept}}<small class="tbs-trade-shortage"><i class="fa-solid fa-triangle-exclamation"></i> Cannot accept as written: {{shortageText}} Counteroffer or abandon this trade.</small>{{/if}}<div class="tbs-trade-buttons"><button class="primary" type="button" data-action="acceptTrade" data-trade-id="{{id}}" {{#if cannotAccept}}disabled{{/if}}><i class="fa-solid fa-check"></i> Accept As Written</button><button type="button" data-action="counterTrade" data-trade-id="{{id}}"><i class="fa-solid fa-right-left"></i> Submit Counteroffer</button>{{#unless cannotAccept}}<button class="danger" type="button" data-action="rejectTrade" data-trade-id="{{id}}"><i class="fa-solid fa-xmark"></i> No</button>{{/unless}}<button class="danger" type="button" data-action="abandonTrade" data-trade-id="{{id}}"><i class="fa-solid fa-ban"></i> Abandon Trade</button></div>{{else}}<div class="tbs-trade-buttons"><button class="danger" type="button" data-action="abandonTrade" data-trade-id="{{id}}"><i class="fa-solid fa-ban"></i> Abandon Trade</button></div>{{/if}}</article>{{else}}<div class="tbs-drop"><i class="fa-solid fa-scale-balanced"></i><strong>No active sale negotiations</strong></div>{{/each}}</div></section>
      <section class="tbs-panel"><div class="tbs-panel-title"><h2>Stock & prices</h2><small>Drop an item in the empty area to stock it; drop onto “Barter item” to set its trade cost.</small></div><div class="tbs-listings">
        {{#each shop.listings}}<article>
          <img src="{{item.img}}"><div class="tbs-listing-name"><strong>{{item.name}}</strong><small>{{item.type}}</small></div><label>Sell bundle<input type="number" min="1" name="listing.{{id}}.bundle" value="{{bundle}}"></label><label>Stock<input type="number" min="0" name="listing.{{id}}.stock" value="{{stock}}" placeholder="∞"></label>
          <label>Accepted payment<select name="listing.{{id}}.payment"><option value="barter" {{#if (eq payment 'barter')}}selected{{/if}}>Barter item only</option><option value="currency" {{#if (eq payment 'currency')}}selected{{/if}}>Regular currency only</option><option value="both" {{#if (eq payment 'both')}}selected{{/if}}>Either / both enabled</option><option value="bestOffer" {{#if (eq payment 'bestOffer')}}selected{{/if}}>Best Offer</option></select></label><label>Regular price<input type="number" min="0" name="listing.{{id}}.amount" value="{{cost.amount}}"></label><label>Coin<input name="listing.{{id}}.denomination" value="{{cost.denomination}}"></label>
          <label>Barter qty<input type="number" min="1" name="listing.{{id}}.quantity" value="{{cost.quantity}}"></label><label class="tbs-cost-drop" data-cost-listing-id="{{id}}">Barter item<div class="tbs-barter-reference">{{#if cost.img}}<img src="{{cost.img}}">{{/if}}<input name="listing.{{id}}.costName" value="{{cost.name}}" placeholder="Drop item here"></div></label><label>Type<input name="listing.{{id}}.costType" value="{{cost.type}}" placeholder="Optional"></label><button class="danger icon" type="button" data-action="removeListing" data-listing-id="{{id}}"><i class="fa-solid fa-xmark"></i></button>
        </article>{{else}}<div class="tbs-drop"><i class="fa-solid fa-box-open"></i><strong>Drop items here to stock the shop</strong></div>{{/each}}
      </div></section>
    </form>{{else}}<div class="tbs-empty"><i class="fa-solid fa-store"></i><h2>Create your first shop</h2><button class="primary" type="button" data-action="create">Create Shop</button></div>{{/if}}
  </main>
</div>
</div>
